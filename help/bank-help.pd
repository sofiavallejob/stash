#N canvas 60 40 780 1420 12;
#X obj 0 0 cnv 1 780 52 empty empty stash/bank 20 26 0 20 #ececec #202020 0;
#X text 20 70 The preset manager. One per namespace: it talks to every stash/param \, stash/array \, stash/morph and stash/ui with the same namespace (here: demo). Messages go into its inlet or to demo-bank from anywhere., f 72;
#X obj 20 140 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 148 the parameters (bound to the sliders by send/receive names);
#X obj 40 200 hsl 200 18 20 20000 1 0 demo-cut demo-cut-r cutoff -2 -10 0 12 #ffffff #5a5a5a #303030 0 1;
#X obj 300 200 hsl 200 18 0 1 0 0 demo-res demo-res-r resonance -2 -10 0 12 #ffffff #5a5a5a #303030 0 1;
#X obj 560 200 hsl 160 18 0 1 0 0 demo-drv demo-drv-r drive -2 -10 0 12 #ffffff #5a5a5a #303030 0 1;
#X obj 40 245 stash/param demo cutoff 20 20000 exp demo-cut demo-cut-r;
#X obj 40 280 stash/param demo res 0 1 lin demo-res demo-res-r;
#X obj 40 315 stash/param demo drive 0 1 lin demo-drv demo-drv-r;
#X obj 20 370 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 378 1 - store and recall;
#X obj 40 455 s demo-bank;
#X msg 40 410 store 1;
#X msg 133 410 store 2;
#X msg 226 410 store 3;
#X msg 319 410 store 4;
#X obj 40 545 s demo-bank;
#X msg 40 500 recall 1;
#X msg 140 500 recall 2;
#X msg 240 500 recall 3;
#X msg 340 500 recall 4;
#X msg 440 500 recall 1 2000;
#X text 170 547 the last one glides over 2000 ms;
#X obj 20 590 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 598 2 - morph;
#X obj 40 645 hsl 200 18 0 1 0 0 empty empty between_1_and_2 -2 -10 0 12 #ffffff #5a5a5a #303030 0 1;
#X msg 40 685 morph 1 2 \$1;
#X obj 40 725 s demo-bank;
#X obj 320 690 s demo-bank;
#X msg 320 645 morph4 1 2 3 4 0.5 0.5;
#X msg 518 645 mix 1 0.2 2 0.3 3 0.5;
#X text 320 725 morph4: four slots on an x/y plane (see stash/morph). mix: any slots with your own weights., f 42;
#X obj 20 800 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 808 3 - manage;
#X obj 40 885 s demo-bank;
