#X text 20 938 4 - sound design;
#X obj 40 1015 s demo-bank;
#X msg 40 970 random 0.2;
#X msg 154 970 exclude res;
#X msg 275 970 include res;
#X text 170 1017 random nudges every float param. excluded params ignore recall \, morph and random.;
#X obj 20 1060 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 1068 5 - files and scan;
#X obj 40 1145 s demo-bank;
#X msg 40 1100 write;
#X msg 119 1100 read;
#X msg 191 1100 write mysynth.txt;
#X msg 354 1100 read mysynth.txt;
#X msg 510 1100 scan mypatch.pd;
#X text 40 1180 files are saved next to your patch (default demo.stash.txt) as plain text: slot name values. scan reads a saved patch and makes a param for every slider \, number box \, toggle or radio whose send name starts with demo-., f 72;
