#N canvas 80 60 900 860 12;
#X text 30 20 stash/bank - store \, recall and morph presets;
#X text 30 55 One bank per namespace. It talks to every stash/param with the same namespace (here: demo).;
#X obj 60 140 hsl 200 20 20 20000 1 0 empty empty cutoff 0 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 60 190 stash/param demo cutoff 20 20000 exp;
#X floatatom 60 240 10 0 0 0 - - - 0;
#X obj 470 140 hsl 200 20 0 1 0 0 empty empty resonance 0 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 470 190 stash/param demo res 0 1 lin;
#X floatatom 470 240 10 0 0 0 - - - 0;
#X text 30 300 1 - move the sliders \, then store into a slot;
#X msg 60 340 store 1;
#X msg 160 340 store 2;
#X text 30 400 2 - jump or glide back;
#X msg 60 440 recall 1;
#X msg 170 440 recall 2;
#X msg 280 440 recall 1 2000;
#X text 420 445 glide over 2000 ms;
#X text 30 500 3 - morph between two slots;
#X obj 60 540 hsl 200 20 0 1 0 0 empty empty slot_1_to_2 0 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X msg 60 580 morph 1 2 \$1;
#X text 30 640 4 - save and load (file goes next to your patch);
#X msg 60 680 write;
#X msg 130 680 read;
#X msg 200 680 write mysynth.txt;
#X msg 380 680 read mysynth.txt;
#X text 560 685 default file: demo.stash.txt;
#X obj 60 760 stash/bank demo;
#X obj 60 800 print stash;
#X text 260 760 outlet: stored / recalled / morphed / written / loaded;
#X msg 560 340 clear;
#X text 630 345 delete all slots;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 3 1 2 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 6 1 5 0;
#X connect 9 0 25 0;
#X connect 10 0 25 0;
#X connect 12 0 25 0;
#X connect 13 0 25 0;
#X connect 14 0 25 0;
#X connect 17 0 18 0;
#X connect 18 0 25 0;
#X connect 20 0 25 0;
#X connect 21 0 25 0;
#X connect 22 0 25 0;
#X connect 23 0 25 0;
#X connect 25 0 26 0;
#X connect 28 0 25 0;
