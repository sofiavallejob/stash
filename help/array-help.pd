#N canvas 60 40 780 660 12;
#X obj 0 0 cnv 1 780 52 empty empty stash/array 20 26 0 20 #ececec #202020 0;
#X text 20 70 Stores a whole array (wavetable \, step sequence \, envelope) as one parameter. Morphs point by point., f 72;
#X obj 20 130 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 138 example;
#N canvas 0 0 450 300 (subpatch) 0;
#X array demo-table 16 float 3;
#A 0 0 0.2 0.5 0.9 1 0.8 0.6 0.4 0.3 0.2 0.1 0.05 0 0 0 0;
#X coords 0 1 16 0 300 120 1 0 0;
#X restore 40 190 graph;
#X obj 400 190 stash/array demo shape demo-table;
#X text 400 230 args: namespace name arrayname, f 30;
#X text 40 340 draw in the array \, store \, draw again \, store again. Recall writes the array back. Morph needs arrays of the same size., f 72;
#X obj 20 400 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 408 setup;
#X obj 40 485 s demo-bank;
#X msg 40 440 store 1;
#X msg 140 440 store 2;
#X msg 240 440 recall 1;
#X msg 340 440 recall 2;
#X obj 40 560 hsl 200 18 0 1 0 0 empty empty morph -2 -10 0 12 #ffffff #5a5a5a #303030 0 1;
#X msg 40 595 morph 1 2 \$1;
