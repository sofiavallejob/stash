#N canvas 100 80 760 700 12;
#X text 30 20 stash/param - one parameter in a stash namespace;
#X text 30 55 Put it between a GUI and whatever it controls. It remembers the value and responds to recall \, glide and morph.;
#X obj 30 130 hsl 200 20 20 20000 1 0 empty empty empty 0 -9 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 30 180 stash/param demo cutoff 20 20000 exp;
#X floatatom 30 230 10 0 0 0 - - - 0;
#X text 360 180 args: namespace name min max mode;
#X text 30 280 Left outlet: the value \, to your destination. Right outlet: set messages on recall only. Connect it back to the GUI so the GUI follows recalls without feedback.;
#X text 360 210 modes: lin \, exp (freq \, gain) \, step (toggles \, menus);
#X text 30 360 Normally stash/bank sends these. You can also send them by hand:;
#X msg 30 400 \; demo-set cutoff 300 1000;
#X text 360 405 glide to 300 Hz in 1000 ms;
#X msg 30 450 \; demo-set cutoff 5000 0;
#X text 360 455 jump to 5000 Hz;
#X msg 30 500 \; demo-morph cutoff 100 8000 0.5;
#X text 360 505 halfway between 100 and 8000 (exp curve);
#X msg 30 550 \; demo-get bang;
#X text 360 555 ask for the current value;
#X obj 30 610 r demo-collect;
#X obj 30 650 print stash;
#X text 360 615 reply: p cutoff <value>;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 3 1 2 0;
#X connect 17 0 18 0;
