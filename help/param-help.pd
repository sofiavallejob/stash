#X obj 40 500 r demo-res;
#X floatatom 40 540 8 0 0 0 - - - 0;
#X text 460 400 args 6 and 7: the GUI's send and receive names. On recall the value goes out on the send name \, so [r demo-res] gets it., f 38;
#X obj 20 590 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 598 3 - lists and symbols;
#X msg 40 640 1 0 0 1 0 1 1 0;
