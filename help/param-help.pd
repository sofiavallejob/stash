#X obj 20 130 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 138 1 - wired: put it between a GUI and what it controls;
#X obj 40 190 hsl 200 18 20 20000 1 0 empty demo-cut-set cutoff -2 -10 0 12 #ffffff #5a5a5a #303030 0 1;
#X obj 40 240 stash/param demo cutoff 20 20000 exp;
#X floatatom 40 290 8 0 0 0 - - - 0;
#X obj 200 290 s demo-cut-set;
#X text 420 190 left outlet: the value. right outlet: 'set' messages on recall only. Send them back to the GUI (here via its receive name) so the slider follows without feedback., f 42;
#X obj 20 340 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 348 2 - bound: no wires \, use the GUI's send and receive names;
#X obj 40 400 hsl 200 18 0 1 0 0 demo-res demo-res-r resonance -2 -10 0 12 #ffffff #5a5a5a #303030 0 1;
